# =============================================================================
# ArgoCD AppProject — scopes what the runtime ApplicationSets can deploy
# =============================================================================
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: control-plane
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  description: Control plane operations — runtime claims for EKS clusters and Helm installs

  sourceNamespaces:
    - argocd

  # Allow sources from our Git repo and any Helm repo
  sourceRepos:
    - "*"

  # Allow deploying to any cluster registered in ArgoCD, any namespace
  destinations:
    - server: "*"
      namespace: "*"

  # Allowed cluster-scoped resources. Broad by design: workload charts such as
  # kube-prometheus-stack and aws-load-balancer-controller install CRDs and
  # ClusterRoles, so the platform project must permit cluster-scoped kinds.
  clusterResourceWhitelist:
    - group: "*"
      kind: "*"

  # Allowed namespace-scoped resources
  namespaceResourceWhitelist:
    - group: "*"
      kind: "*"
