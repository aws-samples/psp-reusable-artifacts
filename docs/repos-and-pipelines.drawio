        <mxCell id="dp-appset" value="dataplane-{env} ApplicationSets&#xa;Git Directory Generator&#xa;path: runtime/{env}/*/data-plane&#xa;&#xa;→ Generates: {runtime}-dataplane-{env}&#xa;→ Deploys claims to hub cluster&#xa;→ KRO + ACK provision spoke infra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="160" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="apps-appset" value="apps-{env} ApplicationSets&#xa;Git File Generator&#xa;path: runtime/{env}/*/apps/config.json&#xa;&#xa;→ Reads: { chartUrl, chartName, chartVersion }&#xa;→ Generates: {runtime}-apps-{env}&#xa;→ Multi-source: OCI chart + Git values&#xa;→ Deploys Helm to spoke clusters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="290" width="340" height="120" as="geometry" />
        </mxCell>

