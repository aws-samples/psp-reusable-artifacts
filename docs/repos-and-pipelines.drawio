        </mxCell>

        <!-- ============================================================ -->
        <!-- Repositories (top row) -->
        <!-- ============================================================ -->
        <mxCell id="repo-java" value="credit-card-java&#xa;(App Code Repo)&#xa;&#xa;• Java source code&#xa;• Dockerfile&#xa;• buildspec.yml&#xa;• pom.xml&#xa;&#xa;Owner: Dev Team" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="200" height="170" as="geometry" />
        </mxCell>

        <mxCell id="repo-helm" value="credit-card-data-plane&#xa;(Helm Chart Repo)&#xa;&#xa;• Chart.yaml&#xa;• values.yaml&#xa;• templates/&#xa;  deployment.yaml&#xa;  service.yaml&#xa;&#xa;Owner: Dev Team" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="200" height="170" as="geometry" />
        </mxCell>

        <mxCell id="repo-platform" value="control-plane-operations&#xa;(Platform Repo — GitOps)&#xa;&#xa;• argocd/     (manifests)&#xa;• catalog/    (RGDs)&#xa;• runtime/    (claims + apps)&#xa;• applications/ (overrides)&#xa;&#xa;Owner: Platform Team&#xa;Consumed by: ArgoCD" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="220" height="170" as="geometry" />
        </mxCell>

        <!-- ECR Registries -->
        <mxCell id="ecr-box" value="ECR (Container Registry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ecr-image" value="credit-card&#xa;(Docker image)&#xa;:latest, :abc1234" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="60" y="315" width="180" height="45" as="geometry" />
        </mxCell>
