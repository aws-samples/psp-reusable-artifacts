          <mxGeometry x="280" y="315" width="180" height="45" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- Pipeline (middle) -->
        <!-- ============================================================ -->
        <mxCell id="pipeline-box" value="CodePipeline (credit-card-pipeline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="740" height="160" as="geometry" />
        </mxCell>
        <mxCell id="stage1" value="Stage 1: Build Image&#xa;&#xa;1. mvn clean package&#xa;2. docker build&#xa;3. Push to ECR&#xa;   :$COMMIT_SHA + :latest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="stage2" value="Stage 2: Package Chart&#xa;&#xa;1. Clone helm repo&#xa;2. Update image tag&#xa;   in values.yaml&#xa;3. helm package&#xa;4. helm push OCI → ECR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="290" y="450" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="stage3" value="Stage 3: Update Ops Repo&#xa;&#xa;1. Get latest chart version&#xa;2. Get latest image tag&#xa;3. Update config.json&#xa;   + values.yaml in&#xa;   platform repo via&#xa;   codecommit create-commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="520" y="450" width="220" height="110" as="geometry" />
        </mxCell>

